{
  "expo": {
    "name": "REDE27",
    "slug": "rede27",
    "scheme": "rede27",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1931"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rede27.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O REDE27 usa a sua localizacao para calcular a corrida e para o protocolo 03."
      }
    },
    "android": {
      "package": "com.rede27.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A1931",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "REDE27",
      "themeColor": "#0A1931",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O REDE27 usa a sua localizacao para calcular a corrida e para enviar onde voce esta quando acionar o protocolo 03.",
          "locationWhenInUsePermission": "O REDE27 usa a sua localizacao para calcular a corrida e para enviar onde voce esta quando acionar o protocolo 03.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O REDE27 precisa das suas fotos para o cadastro do motorista (perfil e veiculo).",
          "cameraPermission": "O REDE27 usa a camera para tirar a foto de perfil e a foto do veiculo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "38e47e3f-7a23-4ca6-8616-fbe51d7f3ed8"
      },
      "router": {}
    }
  }
}
